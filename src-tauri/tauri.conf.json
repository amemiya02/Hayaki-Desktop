{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hayaki",
  "version": "0.2.1",
  "identifier": "io.github.amemiya02.hayaki",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Hayaki",
        "width": 1280,
        "height": 820,
        "minWidth": 880,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "dragDropEnabled": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "mica",
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost media: http://media.localhost",
        "img-src": "'self' data: blob: media: http://media.localhost https:",
        "media-src": "'self' blob: media: http://media.localhost",
        "frame-src": "'self' media: http://media.localhost plugin: http://plugin.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Hayaki for desktop",
    "longDescription": "An offline flashcard app for your Anki collection.",
    "copyright": "Hayaki contributors. Built on Anki by Ankitects Pty Ltd and contributors.",
    "license": "AGPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "apkg",
          "colpkg"
        ],
        "name": "Anki package",
        "role": "Viewer"
      }
    ]
  }
}
